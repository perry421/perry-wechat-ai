# ---- 模型服务（OpenAI 兼容端点）----
# 主模型：负责生成回复草稿
PWA_LLM_BASE_URL=https://api.openai.com/v1
PWA_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
PWA_LLM_MODEL=gpt-4o-mini

# 备用模型：主模型超时/限流/无余额时降级使用（可留空）
PWA_LLM_FALLBACK_BASE_URL=
PWA_LLM_FALLBACK_API_KEY=
PWA_LLM_FALLBACK_MODEL=

# 本地模型接口（可选，Ollama / LM Studio 等 OpenAI 兼容服务）
PWA_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
PWA_LOCAL_API_KEY=
PWA_LOCAL_MODEL=

# 单次生成的最大 token 数。
# 注意：推理模型（reasoning）会把 reasoning 的 token 计入 completion_tokens，
# 预算给太小会返回**空正文**。实测 DeepSeek 在 max_tokens=16 时 reply 为空串，
# 800 才正常返回。
PWA_MAX_TOKENS_PRIMARY=800
PWA_MAX_TOKENS_FALLBACK=800
PWA_MAX_TOKENS_LOCAL=800

# ---- 成本估算（单位：美元 / 1M tokens）----
# 必须按你自己供应商的当前价格填写，不要照抄示例。
PWA_PRICE_PRIMARY_INPUT=0.0
PWA_PRICE_PRIMARY_OUTPUT=0.0
PWA_PRICE_FALLBACK_INPUT=0.0
PWA_PRICE_FALLBACK_OUTPUT=0.0
PWA_PRICE_LOCAL_INPUT=0.0
PWA_PRICE_LOCAL_OUTPUT=0.0

# ---- 服务 ----
PWA_HOST=127.0.0.1
PWA_PORT=8765
# 仅允许来自本机的浏览器访问；如需改为 0.0.0.0 请自行评估风险
PWA_DATA_DIR=./data

# ---- 观察与安全 ----
# 允许观察的会话名（逗号分隔）。留空表示不观察任何会话。
PWA_ALLOWED_CHATS=
# 是否允许真实发送。默认关闭；打开也仍然需要逐条人工批准。
PWA_ENABLE_SEND=false
# 是否只把内容填进输入框而不按回车。默认开启（dry-run）。
# 只有在 PWA_ENABLE_SEND=true 且本项=false 时，才会真的把消息发出去。
PWA_SEND_DRY_RUN=true
# 发送频率限制：窗口内最多发几条。超限直接拒绝（不排队，避免发出过时的回复）。
PWA_SEND_RATE_MAX=5
PWA_SEND_RATE_WINDOW=60
# 轮询间隔（秒）
PWA_POLL_INTERVAL=3.0
# 单次截图 OCR 的最低置信度，低于该值视为识别不可靠
PWA_OCR_MIN_CONFIDENCE=0.45

# ---- 示例联系人自动回复模式（可选，默认关闭）----
# 打开后系统会代替 Perry 自动回复指定会话。默认关闭，此时系统的行为仍然是
# 规格要求的"只生成草稿、等人逐条审核"。
PWA_AUTO_REPLY_ENABLED=false
# 目标会话名（必须是微信当前正在显示的会话名）
PWA_AUTO_REPLY_CHAT=
# 自动发送允许写入的会话白名单（逗号分隔）。
# **留空 = 不允许向任何会话自动发送**。要开启自动发送必须显式列出。
PWA_AUTO_REPLY_ALLOW_CHATS=
# 轮询间隔（秒）
PWA_AUTO_REPLY_INTERVAL=20
# 连续运行时长（秒），默认 6 小时
PWA_AUTO_REPLY_DURATION=21600
